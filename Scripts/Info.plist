<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>DevCleaner</string>
    <key>CFBundleIdentifier</key>
    <string>com.devcleaner.DevCleaner</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>DevCleaner</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- No LSUIElement any more: since the main Window scene, the Dock tile clicks
         into a real window, so the app is a regular app with a menu bar item on the
         side rather than a menu bar item alone. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Why DevCleaner asks for these folders. macOS shows the sentence in its own
         permission prompt. The Large files page finds big files through Spotlight, and
         Spotlight answers an app that has not been allowed into Documents or Desktop as
         though those folders were empty, so without the grant the page silently misses
         the biggest files on the disk. Downloads is the Downloads cards' folder. -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>DevCleaner looks for large files here so you can decide which ones to move to the Trash. It never removes anything without your click.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>DevCleaner looks for large files here so you can decide which ones to move to the Trash. It never removes anything without your click.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>DevCleaner lists large downloads so you can decide which ones to move to the Trash. It never removes anything without your click.</string>
</dict>
</plist>
